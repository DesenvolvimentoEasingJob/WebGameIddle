# Exemplo .env — copiar para backend/.env (nunca versionar o .env real)

# Database (no Compose a connection string também vem do docker-compose.yml)
DB_CONNECTION=Host=db;Port=5432;Database=skyspire;Username=skyspire;Password=skyspire

# Auth / signing
JWT_SECRET=change-me-min-32-chars-long-secret!!
HMAC_SECRET=change-me-hmac-secret-dev
# Alias opcional: JSON_SIGNING_KEY=...

# Integrações (opcional no início)
PIXELLAB_API_KEY=
PIXEL_API_KEY=
OPENAI_API_KEY=

# Google Gemini — só arte de card de atributo (treino). Itens continuam no PixelLab.
# Modelo de imagem: gemini-2.5-flash-image (gemini-2.5-flash não gera imagem).
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-2.5-flash-image
GOOGLE_PROJECT_ID=

# --- Balance (opcional) ---
# Fonte de verdade: content/config/global.json (editor → Config).
# Descomente só para sobrescrever o JSON em deploy. Ver docs/balance.md.
# XP_BASE=100
# XP_SCALE=1.2
# XP_SCALE_STEP_EVERY=10
# XP_SCALE_STEP=0.1
# FLOOR_DIFFICULTY_MULT=2.0
# FLOOR_REWARD_MULT=1.5
# BOSS_CHALLENGE_ATTR_MULT=10
# BOSS_CHALLENGE_FEE=50
# FLOOR_OWNER_FEE_SHARE=0.10
# DEATH_XP_PENALTY=0.10
# TRAINING_COST_BASE=10
# TRAINING_GOLD_SCALE=1.3
# BATTLE_COIN_REWARD_BASE=2
# HP_REGEN_GLOBAL_MULT=1.0
# HP_DEFEAT_REVIVE_PCT=0.5
# COMBAT_TURN_SECONDS=1.0
# COMBAT_DAMAGE_NOISE=0
